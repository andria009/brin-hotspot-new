HOTSPOT_ENV=development
HOTSPOT_LOG_LEVEL=INFO
HOTSPOT_LOG_FORMAT=json
HOTSPOT_TRACE_FILES=false
HOTSPOT_API_PORT=8000
HOTSPOT_FRONTEND_PORT=8080

HOTSPOT_DB_HOST=db
HOTSPOT_DB_PORT=5432
HOTSPOT_DB_NAME=hotspot
HOTSPOT_DB_USER=hotspot
HOTSPOT_DB_PASSWORD=hotspot_dev

HOTSPOT_RASTER_DB_NAME=raster

HOTSPOT_INPUT_DIR=/app/data/input
HOTSPOT_OUTPUT_DIR=/app/data/output
HOTSPOT_LOG_DIR=/app/logs

HOTSPOT_GEOCATALOG_API_URL=http://host.docker.internal:8090/api/v1
HOTSPOT_GEOCATALOG_ACCESS_TOKEN=
HOTSPOT_GEOCATALOG_TIMEOUT_SECONDS=30
HOTSPOT_GEOCATALOG_OIDC_TOKEN_URL=http://keycloak:8080/realms/brin-geospatial/protocol/openid-connect/token
HOTSPOT_GEOCATALOG_OIDC_CLIENT_ID=hotspot-geocatalog-service
HOTSPOT_GEOCATALOG_OIDC_CLIENT_SECRET=

HOTSPOT_OIDC_ENABLED=false
HOTSPOT_OIDC_ISSUER=https://geomimo-keycloak.brin.go.id/realms/brin-geospatial
HOTSPOT_OIDC_JWKS_URL=http://keycloak:8080/realms/brin-geospatial/protocol/openid-connect/certs
HOTSPOT_OIDC_CLIENT_ID=hotspot-new
HOTSPOT_ACCESS_MANAGEMENT_URL=http://access-management:8181/api/v1
VITE_KEYCLOAK_URL=https://geomimo-keycloak.brin.go.id
VITE_KEYCLOAK_REALM=brin-geospatial
VITE_KEYCLOAK_CLIENT_ID=hotspot-new

MODIS_CONVERTER_INTERVAL_SECONDS=300
MODIS_CONVERTER_DEBUG=false
